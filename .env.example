# Client (same Firebase project as StockFlow)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server — required for /api/email/* and token verification
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP — outbound only (quotes/invoices). Always send as info@ — do not use arshad@ for sending.
# Hostinger Professional Email: use smtp.titan.email (or smtp.hostinger.com — app auto-falls back to Titan)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM=info@yourdomain.com
SMTP_FROM_NAME=Prep Services FBA

# IMAP — inbound contact sync (sender name/email + signature phone/company when found)
# Body is read temporarily for parsing only and is not stored. Outbound send stays SMTP info@.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER_INFO=info@yourdomain.com
IMAP_PASSWORD_INFO=
IMAP_USER_ARSHAD=arshad@yourdomain.com
IMAP_PASSWORD_ARSHAD=

# Optional — proxy email to another deployment
# NEXT_PUBLIC_EMAIL_API_URL=https://your-main-app.com
# NEXT_PUBLIC_VERCEL_PROTECTION_BYPASS=

# Facebook Page Messenger → address book (people who messaged the Page)
# Page access token needs pages_messaging (and pages_read_engagement / pages_manage_metadata as Meta requires).
# FACEBOOK_PAGE_ID=146083453956497
# FACEBOOK_PAGE_ACCESS_TOKEN=EAFZCKeE2LtZCEBSK5DC8DCF8aAq5zEHKI1KqqU3XsrVNsgE7KYsxZCkmWPEOUSSjZCeI7lZB1ZCEJvXEuPGaZBhd8f3jd6sGGpCbYERoBNfCoKfW0TYy9Mlcx7R7KtzEEIWG45CbBTBhKftjQBOLkApe0yxXGJFyy74UnBMZAyAHSgAfT1FmnTniRVhBwa27AwZDZD
# FACEBOOK_GRAPH_API_VERSION=v21.0

# WhatsApp Cloud API → address book (people who message your business number)
# Webhook URL: https://YOUR_CRM_HOST/api/whatsapp/webhook
# Subscribe to: messages. Invent WHATSAPP_VERIFY_TOKEN yourself; paste the same value in Meta.
# WHATSAPP_VERIFY_TOKEN=any-long-random-string
# WHATSAPP_APP_SECRET=from_meta_app_settings_basic
# WHATSAPP_ACCESS_TOKEN=permanent_or_long_lived_cloud_api_token
# WHATSAPP_PHONE_NUMBER_ID=from_whatsapp_api_setup

# Optional feature flags (match StockFlow if used)
# NEXT_PUBLIC_ENABLE_CLIENT_INVOICE_AUTOMATION=false

# Mercury invoicing (Option B: CRM email + Mercury pay link; webhook marks paid)
# API token from https://app.mercury.com/settings/tokens (include secret-token: prefix)
# MERCURY_API_TOKEN=mercury_production_cma_...
# (secret-token: prefix is optional — the app adds it automatically)
# Deposit account UUID from GET https://api.mercury.com/api/v1/accounts
# MERCURY_DESTINATION_ACCOUNT_ID=
# Webhook signing secret shown once when you create the endpoint in Mercury → Settings → Webhooks
# MERCURY_WEBHOOK_SECRET=
# Webhook URL in Mercury:
#   https://YOUR_CRM_HOST/api/mercury/webhook
# If Vercel Deployment Protection blocks Mercury (401), use:
#   https://YOUR_CRM_HOST/api/mercury/webhook?x-vercel-protection-bypass=YOUR_BYPASS_SECRET
# (same value as NEXT_PUBLIC_VERCEL_PROTECTION_BYPASS / Vercel automation bypass secret)
# MERCURY_PAY_URL_BASE=https://app.mercury.com/pay
# MERCURY_CREDIT_CARD_ENABLED=true
# MERCURY_ACH_DEBIT_ENABLED=true
# MERCURY_USE_REAL_ACCOUNT_NUMBER=false
