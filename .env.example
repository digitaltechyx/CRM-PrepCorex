# Client (same Firebase project as StockFlow)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server — required for /api/email/* and token verification
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP — invoice/quote email from this app
# Hostinger Professional Email: use smtp.titan.email (or smtp.hostinger.com — app auto-falls back to Titan)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM=info@yourdomain.com
SMTP_FROM_NAME=Prep Services FBA

# Optional — proxy email to another deployment
# NEXT_PUBLIC_EMAIL_API_URL=https://your-main-app.com
# NEXT_PUBLIC_VERCEL_PROTECTION_BYPASS=

# Optional feature flags (match StockFlow if used)
# NEXT_PUBLIC_ENABLE_CLIENT_INVOICE_AUTOMATION=false
